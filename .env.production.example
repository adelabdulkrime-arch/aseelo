# ============================================================
# ASEELO — production environment
#
# Copy to .env on the server (or paste these into Coolify's
# environment UI). NEVER commit the filled-in version.
#
# Two supported topologies:
#   B) ONE domain (recommended, and what the `proxy` service is for) — the
#      whole app behind a single origin, API at /api. No CORS at all, and it
#      works with a platform-generated domain such as Coolify's sslip.io one.
#   A) two domains — app.example.com + api.example.com. Needs CORS configured
#      exactly right; only worth it if you want the API on its own host.
# Both are described in docs/deployment.md.
# ============================================================

# ---------- Core ----------
APP_ENV=production
LOG_LEVEL=INFO
APP_NAME=ASEELO

# ---------- Database ----------
# No defaults on purpose: the stack refuses to start without these.
POSTGRES_USER=aseelo
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=aseelo

# ---------- Security ----------
# REQUIRED. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The backend refuses to boot in production with the placeholder or anything
# shorter than 32 characters.
JWT_SECRET=CHANGE_ME_generate_a_48_byte_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Exact browser origins allowed to call the API — scheme + host, no trailing
# slash, comma separated. Must be https in production.
#   Topology B (recommended): the one public domain, e.g. Coolify's generated one
CORS_ORIGINS=https://your-app.sslip.io
#   Topology A: CORS_ORIGINS=https://app.example.com

# Host port the `proxy` service listens on. Point your platform's domain at
# this service. Coolify sets this up when you attach a domain to `proxy`.
PROXY_PORT=8080

# ---------- Public URLs ----------
# Origin of the API as the BROWSER sees it. Served to the client at run time
# via /runtime-config.js, so changing it needs a restart, not a rebuild.
#   Topology A:
API_PUBLIC_URL=https://api.example.com
#   Topology B: leave EMPTY for same-origin requests
# API_PUBLIC_URL=

# Where rendered videos and logos are fetched from. Must be publicly reachable
# over https, or the browser will refuse to load media on an https page.
#   Topology A:
PUBLIC_MEDIA_BASE_URL=https://api.example.com/media
#   Topology B: https://example.com/media

# ---------- Storage ----------
# local  = the mediadata volume (single host only, does not survive a rebuild
#          of the volume, and prevents running more than one backend replica)
# s3     = recommended for real production
STORAGE_PROVIDER=local

# Only used when STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2, MinIO, Wasabi …)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aseelo
S3_REGION=auto
# CDN/public origin of the bucket; without it the API issues 1-hour presigned URLs
S3_PUBLIC_BASE_URL=

# ---------- Limits ----------
MAX_UPLOAD_SIZE=536870912
MAX_VIDEO_DURATION_SECONDS=180
RATE_LIMIT_ENABLED=true

# ---------- Rendering ----------
# Keep at or below the host's CPU core count — FFmpeg is CPU-bound and
# oversubscribing makes every render slower.
WORKER_CONCURRENCY=2
OUTPUT_CRF=20
OUTPUT_PRESET=medium
