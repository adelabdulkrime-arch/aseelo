{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // vitest.config.ts imports vitest/config, which pulls in its own nested copy
  // of vite - a different one than the root vite dependency this app's build
  // never otherwise touches. The two Vite types are structurally identical but
  // nominally distinct, so type-checking this file as part of `next build`
  // fails whenever their versions drift, over a file the shipped app never runs.
  "exclude": ["node_modules", "vitest.config.ts"]
}
