# ============================================================
# ASEELO — Coolify Cloud environment
#
# Paste these into the Coolify resource's Environment tab, not into a committed
# file. Values marked REPLACE must be changed before the first deploy; the
# backend deliberately refuses to boot with placeholders or localhost.
#
# Topology: ONE domain, everything behind the `proxy` service. The browser only
# ever talks to a single origin, so there is no CORS to get wrong.
# ============================================================

# ---------- Images ----------
# Built and pushed by .github/workflows/build-images.yml. Owner must be
# lowercase. Pin IMAGE_TAG to sha-<full-sha> to roll back to a known-good build.
IMAGE_PREFIX=ghcr.io/adelabdulkrime-arch
IMAGE_TAG=latest

# ---------- Core ----------
APP_ENV=production
LOG_LEVEL=INFO
APP_NAME=V.onemedia

# ---------- Database ----------
POSTGRES_USER=aseelo
# REPLACE — long random string
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=aseelo

# ---------- Security ----------
# REPLACE — 32+ chars. Generate with:
#   docker compose run --rm backend python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_48_byte_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Public URLs ----------
# REPLACE all three hostnames with the domain you attached to the `proxy`
# service in Coolify. Until you own a domain, Coolify generates an sslip.io
# hostname that resolves to your VPS IP and gets a real Let's Encrypt
# certificate — copy it from the resource's Domains field.
#
# Example, for a generated domain of https://abc123.203.0.113.sslip.io :
#   CORS_ORIGINS=https://abc123.203.0.113.sslip.io
#   PUBLIC_MEDIA_BASE_URL=https://abc123.203.0.113.sslip.io/media
#
# Scheme included, NO trailing slash, no path on CORS_ORIGINS.
CORS_ORIGINS=https://REPLACE.sslip.io
PUBLIC_MEDIA_BASE_URL=https://REPLACE.sslip.io/media

# Origin of the API as the BROWSER sees it. MUST be empty here: the proxy
# serves the API under the same domain at /api, so requests are same-origin.
# Leave the variable present with no value — do not delete the line.
API_PUBLIC_URL=

# ---------- Storage ----------
# `local` keeps media in the mediadata volume. Fine to start; switch to s3
# before this matters, because the local volume is also what stops you running
# more than one backend replica.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aseelo
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ---------- Limits ----------
# Must stay below the proxy body limit. nginx.conf allows 512m; Coolify's
# Traefik sits in front of it and has its own, lower default — a 413 on upload
# is almost always Traefik, not this app.
MAX_UPLOAD_SIZE=536870912
RATE_LIMIT_ENABLED=true

# ---------- Rendering (1-core VPS) ----------
# Measured, not guessed: this codebase renders at ~14x realtime on one core.
#   45 s of video  -> ~10 min of fully saturated CPU
#   60 s of video  -> ~14 min
#   180 s of video -> ~40 min, during which the whole app feels broken
# 45 keeps the worst case tolerable. Raise it only after adding cores.
MAX_VIDEO_DURATION_SECONDS=45
# One core, one render at a time.
WORKER_CONCURRENCY=1
# ~6% faster than `medium` — the bottleneck is the filter graph, not the encode.
OUTPUT_PRESET=veryfast
OUTPUT_CRF=20

# ---------- Password reset / mail ----------
# The public origin of the app — same domain as CORS_ORIGINS under this
# topology. Reset links are built from it, and production refuses to boot if
# MAIL_BACKEND=smtp while this is empty or points at localhost.
APP_PUBLIC_URL=https://REPLACE.sslip.io
# console = log instead of send (password reset will NOT reach users).
# smtp    = real delivery; fill in the SMTP_* group below.
MAIL_BACKEND=console
MAIL_FROM=V.onemedia <no-reply@REPLACE.example>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RATE_LIMIT=5/hour
# Redeeming a payment charge into an account. Tight: a guessed
# (email, charge_id) pair creates an account.
SETUP_ACCOUNT_RATE_LIMIT=10/hour

# ---------- Guest sessions ----------
# Lets a visitor try the app before signing up; login remains available either
# way. Each guest can queue a render, and one render saturates a single core -
# turn this off as an emergency brake if the host cannot keep up.
GUEST_SESSIONS_ENABLED=true
GUEST_RATE_LIMIT=30/hour
# How long a guest's work survives before scripts.prune_guests reclaims it.
GUEST_RETENTION_DAYS=7
# Guests only; registered users keep MAX_VIDEO_DURATION_SECONDS.
# Whatever you set, tell the user: the API publishes this ceiling on
# /api/auth/me so the upload form can state it before a file is chosen.
GUEST_MAX_VIDEO_DURATION_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
