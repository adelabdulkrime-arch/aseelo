# ============================================================
# ASEELO - Environment configuration example
# Copy to .env and adjust. NEVER commit a real .env file.
# ============================================================

# ---------- Core ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Database ----------
# Inside docker compose the host is the service name "postgres".
DATABASE_URL=postgresql+psycopg://aseelo:aseelo@postgres:5432/aseelo
POSTGRES_USER=aseelo
POSTGRES_PASSWORD=aseelo
POSTGRES_DB=aseelo

# ---------- Queue ----------
REDIS_URL=redis://redis:6379/0

# ---------- Security ----------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Storage ----------
# local | s3
STORAGE_PROVIDER=local
STORAGE_PATH=/data/storage
# Public base URL used to build media links served by the backend
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media

# S3 / R2 / MinIO (only used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aseelo
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ---------- Uploads ----------
# 512 MB
MAX_UPLOAD_SIZE=536870912
MAX_LOGO_SIZE=5242880
MAX_VIDEO_DURATION_SECONDS=180
MIN_VIDEO_DURATION_SECONDS=1

# ---------- FFmpeg ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
OUTPUT_CRF=20
OUTPUT_PRESET=medium
OUTPUT_AUDIO_BITRATE=128k

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=30/hour

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ASEELO
